[Unit]
Description=trade 看板（FastAPI，只监听 127.0.0.1）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trade
Environment=DASHBOARD_CONTROL_PIN_FILE=/home/ubuntu/trade/.dashboard_pin
ExecStart=/bin/bash -lc 'if [ -f "$DASHBOARD_CONTROL_PIN_FILE" ]; then export DASHBOARD_CONTROL_PIN="$(cat "$DASHBOARD_CONTROL_PIN_FILE")"; fi; exec /home/ubuntu/trade-venv/bin/python -m trade.dashboard --config configs/dashboard.yaml'
Restart=always
RestartSec=5
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
