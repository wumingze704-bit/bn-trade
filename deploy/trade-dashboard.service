[Unit]
Description=trade 看板（FastAPI，只监听 127.0.0.1）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trade
Environment=PYTHONDONTWRITEBYTECODE=1
# 控制 PIN 由 configs/dashboard.yaml 的 control.pin_file 读取（不经过登录 shell）
ExecStart=/home/ubuntu/trade-venv/bin/python -m trade.dashboard --config configs/dashboard.yaml
Restart=on-failure
RestartSec=5
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/trade/artifacts/live

[Install]
WantedBy=multi-user.target

