# 看门狗重启实例所需的最小 sudo 权限（docs/07 通知、日报与看门狗）。
# 只允许执行白名单校验脚本 trade-restart-unit（它只重启 trade-runner / trade-runner-live 实例），
# 不授予 systemctl 的其他子命令或任意命令。
# 安装：sudo install -m 440 -o root -g root deploy/sudoers-trade-watchdog /etc/sudoers.d/trade-watchdog
ubuntu ALL=(root) NOPASSWD: /usr/local/sbin/trade-restart-unit *


